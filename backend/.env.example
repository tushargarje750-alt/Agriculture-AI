# Copy to backend/.env and fill in. backend/.env is git-ignored.

# Google Gemini key for the chatbot (https://aistudio.google.com/app/apikey).
# Without it the server still runs; /chat returns 503.
API_KEY=your_google_gemini_api_key
# GEMINI_MODEL=gemini-2.5-flash

# Firebase service-account JSON (Firebase console > Project settings > Service accounts).
# When set, every API call must carry the user's Firebase login token.
# Leave empty for local development; the server then warns that endpoints are open.
GOOGLE_APPLICATION_CREDENTIALS=
# Refuse to start without the service account (use this when deploying).
# AUTH_REQUIRED=true

# Frontend addresses allowed to call the API (comma-separated).
CORS_ORIGINS=http://localhost:5173

# Server. Keep FLASK_HOST=127.0.0.1 and FLASK_DEBUG=0 unless you know you need otherwise:
# the debugger lets anyone who can reach it run code on your machine.
# FLASK_HOST=127.0.0.1
# PORT=5000
# FLASK_DEBUG=0
